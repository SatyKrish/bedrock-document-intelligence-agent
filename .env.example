# Defaults make zero AWS/model calls. Never put tokens in frontend VITE_* variables.
MODE=mock
PORT=3000
# live requires explicit approval and docs/agentcore-cli.md and docs/aws-validation.md gates
# MODE=bedrock
# OIDC_ISSUER=https://your-approved-issuer
# OIDC_JWKS_URL=https://your-approved-issuer/.well-known/jwks.json
# OIDC_AUDIENCE=https://your-approved-app/mcp
# PUBLIC_ORIGIN=https://your-approved-app
# SILOS_FILE=/absolute/path/to/private-silos.json
# CATALOG_ACL_FILE=/absolute/path/to/private-catalog-acl.json
# STATE_FILE=/absolute/path/to/private-live-state.sqlite
# OIDC_CLIENT_ID=approved-public-spa-client-id
# OIDC_CONNECT_ORIGINS=https://your-approved-issuer
