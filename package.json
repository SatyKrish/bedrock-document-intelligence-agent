{
  "name": "bedrock-document-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && node scripts/build-server.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "plugin:pack": "node scripts/package-plugin.mjs",
    "format": "prettier --write server web infra deployment deploy tests *.ts plugin scripts/package-plugin.mjs",
    "format:check": "prettier --check server web infra deployment deploy tests *.ts plugin scripts/package-plugin.mjs",
    "start": "node dist/server/index.js",
    "deploy": "npm run agentcore -- deploy",
    "test:live:readback": "tsx deployment/live-readback.ts",
    "agentcore": "cd agentcore-reference/DocIntelReference && AGENTCORE_CONFIG_DIR=\"$PWD/cli-settings\" AGENTCORE_TELEMETRY_DISABLED=1 agentcore",
    "test:live:runtime": "tsx deployment/runtime-acceptance.ts",
    "baseline:plan": "tsx deployment/aws-baseline.ts",
    "baseline:prepare": "python3 scripts/prepare-baseline.py"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.28",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/credential-provider-node": "^3.0.0",
    "@aws-sdk/credential-providers": "^3.1151.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@smithy/protocol-http": "^5.0.0",
    "@smithy/signature-v4": "^5.0.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "^10.4.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@aws/agentcore": "0.31.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "4.1.12"
  },
  "license": "MIT"
}
