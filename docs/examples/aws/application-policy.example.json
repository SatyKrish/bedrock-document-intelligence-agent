{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ApplicationSessionApi",
      "Effect": "Allow",
      "Action": [
        "bedrock-mantle:CreateAgentSession",
        "bedrock-mantle:GetAgentSession",
        "bedrock-mantle:CreateAgentSessionEvent",
        "bedrock-mantle:ListAgentSessionEvents",
        "bedrock-mantle:ListAgentSessionItems"
      ],
      "Resource": "arn:aws:bedrock-mantle:us-east-1:__ACCOUNT_ID__:project/*"
    },
    {
      "Sid": "PassOnlyOwnedSessionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::__ACCOUNT_ID__:role/__OWNER_SESSION_ROLE_NAME__",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-mantle.amazonaws.com"
        }
      }
    },
    {
      "Sid": "StageOwnedInputs",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::__INPUT_BUCKET__/inputs/*"
    },
    {
      "Sid": "ReadOwnedReports",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::__OUTPUT_BUCKET__/*"
    }
  ]
}
