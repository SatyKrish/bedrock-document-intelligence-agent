{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServiceTrust",
      "Effect": "Allow",
      "Principal": {
        "Service": "bedrock-mantle.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "__ACCOUNT_ID__"
        },
        "ArnLike": {
          "aws:SourceArn": [
            "arn:aws:bedrock-mantle:us-east-1:__ACCOUNT_ID__:session/*",
            "arn:aws:bedrock-mantle:us-east-1:__ACCOUNT_ID__:project/*"
          ]
        }
      }
    }
  ]
}
