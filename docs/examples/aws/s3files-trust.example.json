{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServiceTrust",
      "Effect": "Allow",
      "Principal": {
        "Service": "elasticfilesystem.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "__ACCOUNT_ID__"
        },
        "ArnLike": {
          "aws:SourceArn": "__OWNER_FILESYSTEM_SOURCE_ARN__"
        }
      }
    }
  ]
}
